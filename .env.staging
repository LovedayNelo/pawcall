# PawCall — Staging Environment Configuration

# Database
DATABASE_URL="postgresql://$DB_USER@$DB_HOST:5432/pawscall_staging?schema=public"
PLATFORM_DATABASE_URL="postgresql://$DB_USER@$DB_HOST:5432/pawscall_platform_staging?schema=public"
DEMO_TENANT_DATABASE_URL="postgresql://$DB_USER@$DB_HOST:5432/pawscall_demo_staging?schema=public"

# Auth
AUTH_SECRET="staging-auth-secret-change-this-in-ci"

# App Configuration
NEXT_PUBLIC_APP_URL="https://pawcall-staging.vercel.app"

# Currency
CURRENCY="NGN"

# Stripe (Staging — Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET=""
STRIPE_PLATFORM_FEE_RATE="0.20"
STRIPE_INSTANT_PAYOUT_THRESHOLD_CENTS="42000"

# Video Provider (Staging — Mock or Daily/Twilio Test Keys)
VIDEO_PROVIDER="mock"
DAILY_API_KEY=""
DAILY_API_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Logging
NODE_ENV="production"
