# PawCall — Development Environment Configuration

# Database
DATABASE_URL="postgresql://$DB_USER@$DB_HOST:5432/pawscall_dev?schema=public"
PLATFORM_DATABASE_URL="postgresql://$DB_USER@$DB_HOST:5432/pawscall_platform_dev?schema=public"
DEMO_TENANT_DATABASE_URL="postgresql://$DB_USER@$DB_HOST:5432/pawscall_demo_dev?schema=public"

# Auth
AUTH_SECRET="dev-auth-secret-change-this-in-ci"

# App Configuration
NEXT_PUBLIC_APP_URL="https://pawcall-dev.vercel.app"

# Currency
CURRENCY="NGN"

# Stripe (Development — Mock mode by default)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PLATFORM_FEE_RATE="0.20"
STRIPE_INSTANT_PAYOUT_THRESHOLD_CENTS="42000"

# Video Provider (Development — Mock mode by default)
VIDEO_PROVIDER="mock"
DAILY_API_KEY=""
DAILY_API_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Logging
NODE_ENV="development"
